{
  "title": "Social Feed",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Feed request rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/feed/home\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Feed p99",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/feed/home\"}[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox backlog",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "feed_outbox_backlog"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fanout entries/sec",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(feed_fanout_entries_total[5m])"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(feed_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(feed_cache_total[5m])),1)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Visibility filtering",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(feed_visibility_filtered_total[5m])"
        }
      ]
    }
  ]
}
